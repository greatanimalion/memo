{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*","src/preload/**/*", "plugins/**/*", "src/types"],
  "exclude": ["./node_modules","server"],
  "compilerOptions": {
    "composite": true,
     "jsx": "react-jsx",
    // "types": ["electron-vite/node"],
    "baseUrl": ".",

    "paths": {
      "@main/*": ["src/main/*"],
      "@type": ["src/types"],
      "@type/*": ["src/types/*"]
    }
  },
}
