{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx", 
    "src/preload/*.d.ts"
  ],
    "exclude": ["./node_modules"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations":"6.0",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@type/*": ["src/types/*"]
    }
  },
}
